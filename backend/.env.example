# Copie este arquivo para .env e preencha com os seus dados locais.
# NUNCA envie o .env real para o repositório.

# ===== DJANGO =====
SECRET_KEY=coloque-aqui-uma-chave-secreta-longa-e-aleatoria
# Em produção, obrigatoriamente False
DEBUG=True
# Em produção, liste o domínio do Render: seuapp.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== BANCO DE DADOS PostgreSQL =====
DB_NAME=labic_db
DB_USER=postgres
DB_PASS=suasenhaaqui
DB_HOST=localhost
DB_PORT=5432

# ===== CORS =====
# Lista separada por vírgula; sem espaços ao redor das vírgulas.
# Em desenvolvimento o Django usa http://localhost:5173 como fallback automático
# caso esta variável não esteja definida.
# Em produção, liste TODAS as origens do frontend explicitamente:
#   CORS_ALLOWED_ORIGINS=https://seu-frontend.vercel.app,https://labic.edu.br
CORS_ALLOWED_ORIGINS=http://localhost:5173
